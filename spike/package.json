{
  "name": "my-meshes-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri 2 de-risking spike for My Meshes: WebView2 + Three.js, OffscreenCanvas thumbnails, WebDriver E2E, MSIX.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:browser": "node test/browser-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@wdio/tauri-plugin": "^1.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/three": "^0.186.0",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/tauri-service": "^1.5.0",
    "expect-webdriverio": "^6.0.9",
    "playwright": "^1.56.1",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
